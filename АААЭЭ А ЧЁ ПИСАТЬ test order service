from dataclasses import dataclass, field
from datetime import datetime
from enum import IntEnum
from typing import List


class OrderStatus(IntEnum):
    NEW = 1
    PAID = 2
    DELIVERED = 3
    CANCELLED = 4


class LoyaltyTier(IntEnum):
    BASIC = 1       # 0%
    SILVER = 2      # 5%
    GOLD = 3        # 10%

    @property
    def discount_rate(self) -> float:
        return {LoyaltyTier.BASIC: 0.0, LoyaltyTier.SILVER: 0.05, LoyaltyTier.GOLD: 0.10}[self]


@dataclass
class OrderItem:
    id: int
    sku: str
    title: str
    price: float
    quantity: int


@dataclass
class Order:
    id: int
    client_id: int
    status: OrderStatus
    created_at: datetime
    items: List[OrderItem] = field(default_factory=list)
    total_amount: float = 0.0
    discount_amount: float = 0.0

    @property
    def raw_total(self) -> float:
        return sum(item.price * item.quantity for item in self.items)


@dataclass
class Client:
    id: int
    name: str
    loyalty_tier: LoyaltyTier


class LegacyOrderService:
    def find_duplicate_skus(self, orders):
        seen, duplicates = set(), set()
        for order in orders:
            for item in order.items:
                if item.sku in seen:
                    duplicates.add(item.sku)
                else:
                    seen.add(item.sku)
        return sorted(duplicates)

    def apply_discounts(self, orders, clients):
        clients_by_id = {c.id: c for c in clients}
        for order in orders:
            if order.status == OrderStatus.CANCELLED:
                continue
            client = clients_by_id.get(order.client_id)
            rate = client.loyalty_tier.discount_rate if client else 0.0
            order.discount_amount = round(order.raw_total * rate, 2)
            order.total_amount = round(order.raw_total - order.discount_amount, 2)

    def generate_batch_report(self, orders):
        lines = ["=== СВОДНЫЙ ОТЧЕТ ПО ПАЧКЕ ЗАКАЗОВ ==="]
        for order in orders:
            lines.append(
                f"Заказ #{order.id} [Клиент {order.client_id}] - "
                f"Итого: {order.total_amount:.2f}, Скидка: {order.discount_amount:.2f}"
            )
        lines.append(f"Всего обработано заказов: {len(orders)}")
        return "\n".join(lines) + "\n"
